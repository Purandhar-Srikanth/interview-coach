# Copy this file to .env and fill in your values. .env is gitignored — never commit it.

# --- OpenAI ---
# openai = real calls; mock = canned answers for offline testing (no key, no cost)
LLM_MODE=openai
OPENAI_API_KEY=sk-your-key-here
# Main model: scores answers (quality matters most here)
MODEL_MAIN=gpt-6.1-terra
# Cheap model: questions, profile analysis, round summary
MODEL_FAST=gpt-6-luna
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
# none | low | medium | high — low is fast, cheap and consistent enough here
REASONING_EFFORT=low

# --- Cost limits (US dollars) ---
SESSION_COST_CAP_USD=0.25
DAILY_COST_CAP_USD=1.00

# --- Demo mode (public live demo only) ---
DEMO_MODE=false
DEMO_ROUNDS_PER_VISITOR_PER_DAY=2
DEMO_ROUNDS_PER_IP_PER_DAY=6
DEMO_REQUESTS_PER_MINUTE=20
DEMO_DATA_RETENTION_DAYS=7

# --- Database ---
# Local default is a SQLite file. In production use a Postgres URL (e.g. Neon):
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=sqlite:///./interview_coach.db
